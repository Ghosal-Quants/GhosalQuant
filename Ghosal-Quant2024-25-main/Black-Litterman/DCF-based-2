weight_momentum = 0.5  # Define weight for momentum
weight_factors = 0.3  # Weight for Fama-French factors
weight_dcf = 0.2  # Further reduce weight for DCF-based expected return
weight_hist = 0.3  # Further reduce weight for historical mean return

def black_litterman(Sigma, w_mkt, P, Q, tau=0.05, delta=0.3, Omega=None):
    # Calculate equilibrium returns (implied returns)
    pi = delta * Sigma @ w_mkt
    # If Omega is not provided, calculate it based on uncertainty in views
    if Omega is None:
        # Use a variance-scaled Omega to better reflect uncertainty in views
        Omega = np.diag(np.diag(P @ Sigma @ P.T)) * tau
    # Compute the posterior expected returns (mu_bl)
    mu_bl = np.linalg.inv(np.linalg.inv(tau * Sigma) + P.T @ np.linalg.inv(Omega) @ P) @ \
            (np.linalg.inv(tau * Sigma) @ pi + P.T @ np.linalg.inv(Omega) @ Q)
    # Compute the posterior covariance matrix (Sigma_bl)
    Sigma_bl = Sigma + np.linalg.inv(np.linalg.inv(tau * Sigma) + P.T @ np.linalg.inv(Omega) @ P)
    return mu_bl, Sigma_bl

def fetch_data(stocks, start_date, end_date, retries=3):
    for attempt in range(retries):
        try:
            data = yf.download(stocks, start=start_date, end=end_date)['Adj Close']
            if data.empty:
                raise ValueError("Downloaded data is empty.")
            data = data.dropna()  # Drop rows with missing data
            returns = data.pct_change().dropna()  # Calculate daily returns
            return data, returns
        except Exception as e:
            if attempt < retries - 1:
                print(f"Attempt {attempt + 1} failed to download data. Retrying...")
                time.sleep(3)  # Wait before retrying
            else:
                raise ValueError(f"Unable to download data after {retries} attempts. Error: {e}")

def fetch_shares_outstanding(stocks):
    # Fetch shares outstanding for each stock with retry mechanism
    shares_outstanding = {}
    for stock in stocks:
        ticker = yf.Ticker(stock)
        retries = 10  # Increased number of retries for reliability
        for attempt in range(retries):
            try:
                info = ticker.info
                if info is None:
                    raise ValueError(f"Ticker info for {stock} is None.")

                shares_outstanding[stock] = info.get('sharesOutstanding')

                if shares_outstanding[stock] is None:
                    raise ValueError(f"Shares outstanding for {stock} is missing.")
                break
            except Exception as e:
                if attempt < retries - 1:
                    print(f"Attempt {attempt + 1} failed for {stock}. Retrying...")
                    time.sleep(5)  # Wait before retrying
                else:
                    print(f"Unable to fetch shares outstanding for {stock} after {retries} attempts. Attempting alternative methods...")
                    # Attempt to estimate shares outstanding using market cap and current price
                    info = ticker.info  # Retry fetching info in case it was rate-limited
                    if info is not None:
                        market_cap = info.get('marketCap')
                    else:
                        market_cap = None
                    current_price = ticker.history(period='1d')['Close'].iloc[-1] if not ticker.history(period='1d').empty else None
                    if market_cap and current_price:
                        shares_outstanding[stock] = market_cap / current_price
                        print(f"Estimated shares outstanding for {stock} using market cap and current price.")
                    else:
                        raise ValueError(f"Unable to fetch or estimate shares outstanding for {stock}.")
    return shares_outstanding


# New function to fetch stock currencies
def fetch_stock_currency(stocks):
    stock_currency = {}
    for stock in stocks:
        try:
            ticker = yf.Ticker(stock)
            stock_currency[stock] = ticker.info.get('currency', 'USD')
        except Exception as e:
            print(f"Error fetching currency for {stock}: {e}")
    return stock_currency


# Modify existing market cap fetch to include currency conversion
def fetch_market_caps(stocks, stock_currency):
    """
    Fetch market caps for stocks and convert them to the base currency.
    Args:
        stocks (list): List of stock tickers.
        stock_currency (list): List of currencies corresponding to each stock.
        exchange_rates (dict): Dictionary of exchange rates.
        base_currency (str): Target currency (default: 'USD').
    Returns:
        np.array: Array of market caps in the base currency.
    """
    market_caps = []
    for stock in stocks:
        try:
            ticker = yf.Ticker(stock)
            market_cap = ticker.info.get('marketCap', None)

            if market_cap is None:
                print(f"Market cap not available for {stock}. Adding NaN.")
                market_caps.append(np.nan)
                continue
  
            market_caps.append(float(market_cap))  # Ensure float type
        except Exception as e:
            print(f"Error fetching market cap for {stock}: {e}. Adding NaN.")
            market_caps.append(np.nan)

    return np.array(market_caps, dtype=np.float64)


def checkAndConvertForGbp(data, stock_currency):
    
    converted_data = data.copy()
    for stock, currency in zip(data.columns, stock_currency):
        if currency == 'GBp':
            converted_data[stock] /= 100
    return converted_data

def calculate_expected_returns(dcf_inputs, historical_returns, factors):
    # Calculate expected returns using a well-established DCF-based approach, historical returns, and Fama-French factors
    Q = []

    for i, (inputs, hist_return) in enumerate(zip(dcf_inputs, historical_returns)):
        stock = inputs['stock']
        current_price = inputs['current_price']
        intrinsic_value_per_share = inputs['intrinsic_value_per_share']
        # Calculate DCF-based expected return
        expected_return_dcf = (intrinsic_value_per_share - current_price) / current_price # Implied share price for: intrinsic_value_per_share
    
        # Combine DCF-based return, historical return, and Fama-French factors
        # Fama-French factor contribution
        # Fama-French factor contribution
        factor_weights = np.array([0.3, 0.2, 0.2, 0.15, 0.15])
        factor_values = np.array([
            factors['market_excess'],
            factors['size'],
            factors['value'],
            factors['profitability'],
            factors['investment']
        ])
        factor_return = factor_values @ factor_weights
        expected_return = weight_dcf * expected_return_dcf + weight_hist * hist_return + weight_factors * factor_return
        Q.append(expected_return)
        print(f"{stock} - Expected Return: {expected_return * 100:.2f}%")
    return np.array(Q)

def fetch_fama_french_factors():
    # Fetch Fama-French 5-factor monthly data
    fama_french = web.DataReader("F-F_Research_Data_5_Factors_2x3", "famafrench")
    ff_data = fama_french[0]  # Extract the factor returns
    ff_data = ff_data / 100  # Convert percentages to decimals
    return ff_data

def get_fama_french_dict(fama_french_factors):
    # Extract the most recent factor returns
    latest_factors = fama_french_factors.iloc[-1]

    # Create the dictionary
    factors = {
        'market_excess': latest_factors['Mkt-RF'],
        'size': latest_factors['SMB'],
        'value': latest_factors['HML'],
        'profitability': latest_factors['RMW'],
        'investment': latest_factors['CMA']
    }
    return factors

def calculate_momentum_factors(returns):
    cumulative_return = (1 + returns).rolling(window=60).apply(np.prod, raw=True) - 1
    return cumulative_return.iloc[-1].values

def determine_market_regime(returns):
    # Use Hidden Markov Model to determine the current market regime (e.g., bull or bear market)
    model = hmm.GaussianHMM(n_components=2, covariance_type='diag', n_iter=1000)
    model.fit(returns)
    hidden_states = model.predict(returns)
    # Assuming state 0 is bear and state 1 is bull based on mean returns
    bear_market = np.argmin(model.means_)
    return bear_market, hidden_states[-1]

def monte_carlo_simulation(returns, w_bl, num_days = 252, num_simulations=1000):
    """
    Simulates portfolio paths using log returns draws from multivariate normal
    """
    log_mean_returns = returns.mean().values  # Mean of log returns
    log_cov_matrix = returns.cov().values     # Covariance matrix of log returns

    # Simulate multi-asset log returns, account for structure of covariance of the assets 
    simulated_log_returns = np.random.multivariate_normal(log_mean_returns, log_cov_matrix, (num_days, num_simulations))

    # Take linear combo of paths to recover full portfolio movement
    portfolio_log_returns = np.dot(simulated_log_returns, w_bl)

    # exp to get back to actual returns 
    simulated_cumulative_returns = np.exp(np.cumsum(portfolio_log_returns, axis=0))
    return simulated_cumulative_returns

def main():

    # Define start and end dates
    start_date = '2022-01-01'
    end_date = datetime.today().strftime('%Y-%m-%d')

    # Define list of stocks
    stocks = ['TPR', 'RWE.DE', 'IMI.L', 'RIO', 'CALM', 'GOOGL']

    # Fetch stock currencies
    stock_currency = fetch_stock_currency(stocks)

    # Fetch shares outstanding
    try:
        shares_outstanding = fetch_shares_outstanding(stocks)
    except ValueError as e:
        print(f"Error fetching shares outstanding: {e}")
        return

    # Fetch and convert market caps
    market_caps = fetch_market_caps(stocks, [stock_currency[s] for s in stocks])

    # Fetch historical data
    try:
        data, returns = fetch_data(stocks, start_date, end_date)
    except ValueError as e:
        print(f"Error fetching data: {e}")
        return

    if data.empty:
        raise ValueError("No data available for the given stocks and date range.")
    
    # Convert prices to the base currency
    data_cleaned = checkAndConvertForGbp( data, [stock_currency[s] for s in stocks])

    current_prices = data_cleaned.iloc[-1].to_dict()

    # Calculate market capitalizations
    market_caps = market_caps 

    # Calculate market weights
    w_mkt = market_caps / np.nansum(market_caps)

    # Calculate the covariance matrix using Ledoit-Wolf shrinkage for robustness
    lw = LedoitWolf()
    Sigma = lw.fit(returns).covariance_

    # Define number of assets
    N = len(stocks)

    # Define DCF inputs for each stock
    dcf_inputs = [
        {
            'stock': 'TPR',
            'current_price': current_prices['TPR'],
            'intrinsic_value_per_share': 65.59 
        },
        {
            'stock': 'RWE.DE',
            'current_price': current_prices['RWE.DE'],
            'intrinsic_value_per_share': 42.85
        },
        {
            'stock': 'IMI.L',
            'current_price': current_prices['IMI.L'],
            'intrinsic_value_per_share': 19.52
        },
        {
            'stock': 'RIO',
            'current_price': current_prices['RIO'],
            'intrinsic_value_per_share': 70.09
        },
        {
            'stock': 'CALM',
            'current_price': current_prices['CALM'],
            'intrinsic_value_per_share': 140.16
        },
        {
            'stock': 'GOOGL',
            'current_price': current_prices['GOOGL'],
            'intrinsic_value_per_share': 196.87
        }
    ]

    # Calculate historical mean returns
    historical_returns = returns.mean().values

    # Calculate momentum factors
    momentum_factors = calculate_momentum_factors(returns)

    # Determine market regime and set delta accordingly
    bear_market, current_regime = determine_market_regime(returns)
    delta = 1.0 if current_regime == bear_market else 0.3  # Increase risk aversion in bear market

    # Fetch Fama-French factors
    try:
        fama_french_factors_df = fetch_fama_french_factors()
        fama_french_factors = get_fama_french_dict(fama_french_factors_df)
    except Exception as e:
        print(f"Error fetching Fama-French factors: {e}")
        return

    print("Fama-French Factors (Real Data):")
    print(fama_french_factors)

    # Calculate expected returns using combined DCF, historical returns, Fama-French factors, and momentum factors
    Q = calculate_expected_returns(dcf_inputs, historical_returns, fama_french_factors) + weight_momentum * momentum_factors

    # Define P matrix for views
    P = np.eye(N)

    # Define tau
    tau = 0.05

    # Calculate posterior expected returns and covariance matrix
    mu_bl, Sigma_bl = black_litterman(Sigma, w_mkt, P, Q, tau, delta)

    # Set up optimization problem using cvxpy
    w = cp.Variable(N)
    risk_aversion = delta
    lambda_reg = 0.0005  # Further reduce regularization parameter to encourage diversification
    diversification_penalty = cp.sum(cp.entr(w + 1e-8))  # Entropy-like term to encourage diversification
    risk_adjusted_return_objective = mu_bl @ w - risk_aversion * cp.quad_form(w, Sigma_bl)  # Linear risk-adjusted return objective
    objective = cp.Maximize(risk_adjusted_return_objective + 0.02 * diversification_penalty)  # Increase diversification penalty weight
    
    # Sector constraints - treat each stock as an individual sector
    sector_constraints = [
        w[i] <= 0.4 for i in range(N)  # Set an upper bound to prevent any single stock from dominating the portfolio
    ]
    constraints = [
        cp.sum(w) == 1,
        w >= 0.03  # Lower minimum weight to allow more flexibility in allocation
    ] + sector_constraints
    problem = cp.Problem(objective, constraints)
    problem.solve()
    
    # Get optimal weights
    w_bl = w.value
    
    # Print optimal portfolio weights
    print("\nOptimal Portfolio Weights (Black-Litterman with Constraints):")
    for stock, weight in zip(stocks, w_bl):
        print(f"{stock}: {weight * 100:.2f}%")
    
    # Calculate portfolio returns
    portfolio_returns_bl = returns @ w_bl
    equal_weights = np.full(N, 1 / N)
    portfolio_returns_equal = returns @ equal_weights
   
    # Calculate cumulative returns
    cumulative_returns_bl = (1 + portfolio_returns_bl).cumprod()
    cumulative_returns_equal = (1 + portfolio_returns_equal).cumprod()
    
    # Plot cumulative returns
    plt.figure(figsize=(10, 6))
    plt.plot(cumulative_returns_bl.index, cumulative_returns_bl, label='Black-Litterman Portfolio')
    plt.plot(cumulative_returns_equal.index, cumulative_returns_equal, label='Equal-Weighted Portfolio')
    plt.title('Cumulative Returns')
    plt.xlabel('Date')
    plt.ylabel('Cumulative Return')
    plt.legend()
    plt.grid(True)
    plt.show()

    # Allocation Pie chart
    plt.figure(figsize=(8, 8))
    plt.pie(w_bl, labels=stocks, autopct='%1.1f%%', startangle=140)
    plt.title('Black-Litterman Portfolio Allocation')
    plt.show()

    # Monte Carlo
    simulated_cumulative_returns = monte_carlo_simulation(returns, w_bl)

    # Plot simulation results
    plt.figure(figsize=(10, 6))
    plt.plot(simulated_cumulative_returns, alpha = 0.5)
    plt.title('Monte Carlo Simulation of Portfolio Returns')
    plt.xlabel('Days')
    plt.ylabel('Cumulative Return')
    plt.show()

    
    # Calculate and print descriptive statistics of simulated returns
    mean_return = np.mean(simulated_cumulative_returns)
    std_dev = np.std(simulated_cumulative_returns)
    percentile_5th = np.percentile(simulated_cumulative_returns, 5)
    percentile_95th = np.percentile(simulated_cumulative_returns, 95)

    print(f"Mean Return: {mean_return:.4f}")
    print(f"Standard Deviation: {std_dev:.4f}")
    print(f"5th Percentile: {percentile_5th:.4f}")
    print(f"95th Percentile: {percentile_95th:.4f}")

    # Plot a histogram of simulated returns
    plt.hist(simulated_cumulative_returns, bins=50)  # Adjust bins as needed
    plt.title("Distribution of Simulated Portfolio Returns")
    plt.xlabel("Portfolio Return")
    plt.ylabel("Frequency")
    plt.show()

    # Plot the CDF of simulated returns
    sorted_returns = np.sort(simulated_cumulative_returns)
    cdf_values = np.arange(1, len(sorted_returns) + 1) / len(sorted_returns)
    plt.plot(sorted_returns, cdf_values)
    plt.title("Cumulative Distribution Function of Simulated Returns")
    plt.xlabel("Portfolio Return")
    plt.ylabel("Cumulative Probability")
    plt.grid(True)
    plt.show()

if __name__ == "__main__":
    main()
