import numpy as np
import pandas as pd
import yfinance as yf
from datetime import datetime
import cvxpy as cp
import matplotlib.pyplot as plt
import time

def black_litterman(Sigma, w_mkt, P, Q, tau=0.05, delta=2.5, Omega=None):
    # Calculate equilibrium returns (implied returns)
    pi = delta * Sigma @ w_mkt
    # If Omega is not provided, calculate it
    if Omega is None:
        Omega = np.diag(np.diag(tau * P @ Sigma @ P.T))
    # Compute the posterior expected returns (mu_bl)
    mu_bl = np.linalg.inv(np.linalg.inv(tau * Sigma) + P.T @ np.linalg.inv(Omega) @ P) @ \
            (np.linalg.inv(tau * Sigma) @ pi + P.T @ np.linalg.inv(Omega) @ Q)
    # Compute the posterior covariance matrix (Sigma_bl)
    Sigma_bl = Sigma + np.linalg.inv(np.linalg.inv(tau * Sigma) + P.T @ np.linalg.inv(Omega) @ P)
    return mu_bl, Sigma_bl

def fetch_data(stocks, start_date, end_date, retries=3):
    # Retry mechanism to download adjusted closing prices using yfinance
    for attempt in range(retries):
        try:
            data = yf.download(stocks, start=start_date, end=end_date)['Adj Close']
            if data.empty:
                raise ValueError("Downloaded data is empty.")
            data = data.dropna()  # Drop rows with missing data
            returns = data.pct_change().dropna()  # Calculate daily returns
            return data, returns
        except Exception as e:
            if attempt < retries - 1:
                print(f"Attempt {attempt + 1} failed to download data. Retrying...")
                time.sleep(3)  # Wait before retrying
            else:
                raise ValueError(f"Unable to download data after {retries} attempts. Error: {e}")

def fetch_shares_outstanding(stocks):
    # Fetch shares outstanding for each stock with retry mechanism
    shares_outstanding = {}
    for stock in stocks:
        ticker = yf.Ticker(stock)
        retries = 10  # Increased number of retries for reliability
        for attempt in range(retries):
            try:
                info = ticker.info
                if info is None:
                    raise ValueError(f"Ticker info for {stock} is None.")

                shares_outstanding[stock] = info.get('sharesOutstanding')
                
                if shares_outstanding[stock] is None:
                    raise ValueError(f"Shares outstanding for {stock} is missing.")
                break
            except Exception as e:
                if attempt < retries - 1:
                    print(f"Attempt {attempt + 1} failed for {stock}. Retrying...")
                    time.sleep(5)  # Wait before retrying
                else:
                    print(f"Unable to fetch shares outstanding for {stock} after {retries} attempts. Attempting alternative methods...")
                    # Attempt to estimate shares outstanding using market cap and current price
                    info = ticker.info  # Retry fetching info in case it was rate-limited
                    if info is not None:
                        market_cap = info.get('marketCap')
                    else:
                        market_cap = None
                    current_price = ticker.history(period='1d')['Close'].iloc[-1] if not ticker.history(period='1d').empty else None
                    if market_cap and current_price:
                        shares_outstanding[stock] = market_cap / current_price
                        print(f"Estimated shares outstanding for {stock} using market cap and current price.")
                    else:
                        raise ValueError(f"Unable to fetch or estimate shares outstanding for {stock}.")
    return shares_outstanding

def get_market_caps(stocks):
    tickers = yf.Tickers(stocks)
    market_caps = []
    for stock in stocks:
        market_cap = tickers.tickers[stock].info.get('marketCap', None)
        if market_cap is not None:
            market_caps.append(market_cap)
        else:
            raise ValueError(f"Market cap for {stock} could not be fetched.")
    return np.array(market_caps)

def calculate_expected_returns(dcf_inputs):
    # Calculate expected returns using Discounted Cash Flow (DCF) inputs
    Q = []
    for inputs in dcf_inputs:
        stock = inputs['stock']
        current_price = inputs['current_price']
        projected_cash_flows = inputs['projected_cash_flows']
        terminal_growth_rate = inputs['terminal_growth_rate']
        discount_rate = inputs['discount_rate']
        shares_outstanding = inputs['shares_outstanding']
        net_debt = inputs['net_debt']
        # Calculate present value of projected cash flows
        present_value_cash_flows = sum(
            cash_flow / ((1 + discount_rate) ** t) for t, cash_flow in enumerate(projected_cash_flows, start=1)
        )
        # Calculate terminal value and its present value
        last_year_cash_flow = projected_cash_flows[-1]
        terminal_value = (last_year_cash_flow * (1 + terminal_growth_rate)) / (discount_rate - terminal_growth_rate)
        present_value_terminal = terminal_value / ((1 + discount_rate) ** len(projected_cash_flows))
        # Calculate total present value
        total_present_value = present_value_cash_flows + present_value_terminal
        # Calculate equity value and intrinsic value per share
        equity_value = total_present_value - net_debt
        intrinsic_value_per_share = equity_value / shares_outstanding
        # Calculate expected return
        expected_return = (intrinsic_value_per_share - current_price) / current_price
        Q.append(expected_return)
        print(f"{stock} - Expected Return: {expected_return * 100:.2f}%")
    return np.array(Q)

def main():
    # Define list of stocks
    stocks = ['TPR', 'RWE.DE', 'IMI.L', 'RIO', 'CALM', 'GOOGL']
    # Define start and end dates
    start_date = '2022-01-01'
    end_date = datetime.today().strftime('%Y-%m-%d')
    # Fetch historical data
    try:
        data, returns = fetch_data(stocks, start_date, end_date)
    except ValueError as e:
        print(f"Error fetching data: {e}")
        return

    # Fetch current prices of stocks
    if data.empty:
        raise ValueError("No data available for the given stocks and date range.")
    current_prices = data.iloc[-1].to_dict()
    # Fetch shares outstanding
    try:
        shares_outstanding = fetch_shares_outstanding(stocks)
    except ValueError as e:
        print(f"Error fetching shares outstanding: {e}")
        return
    # Calculate market capitalizations
    market_caps = get_market_caps(stocks)
    # Calculate market weights
    w_mkt = market_caps / np.nansum(market_caps)
    # Calculate the covariance matrix
    Sigma = returns.cov().values
    # Define number of assets
    N = len(stocks)
    # Define DCF inputs for each stock
    dcf_inputs = [
        {
            'stock': 'TPR',
            'current_price': current_prices['TPR'],
            'projected_cash_flows': [1087e6, 997e6, 1035e6, 1055e6, 1071e6, 1087e6, 1079e6],
            'terminal_growth_rate': 0.02,
            'discount_rate': 0.082,
            'shares_outstanding': shares_outstanding['TPR'],
            'net_debt': 820e6
        },
        {
            'stock': 'RWE.DE',
            'current_price': current_prices['RWE.DE'],
            'projected_cash_flows': [1605e6, 2854e6, 1845e6, 1512e6, 1760e6, 2211e6, 2391e6, 2109e6],
            'terminal_growth_rate': 0.015,
            'discount_rate': 0.073,
            'shares_outstanding': shares_outstanding['RWE.DE'],
            'net_debt': 2387e6
        },
        {
            'stock': 'IMI.L',
            'current_price': current_prices['IMI.L'],
            'projected_cash_flows': [253e6, 291e6, 328e6, 351e6, 368e6, 376e6, 377e6],
            'terminal_growth_rate': 0.015,
            'discount_rate': 0.077,
            'shares_outstanding': shares_outstanding['IMI.L'],
            'net_debt': 612e6
        },
        {
            'stock': 'RIO',
            'current_price': current_prices['RIO'],
            'projected_cash_flows': [8222e6, 7440e6, 6874e6, 6557e6, 6516e6, 6620e6, 6726e6],
            'terminal_growth_rate': 0.015,
            'discount_rate': 0.068,
            'shares_outstanding': shares_outstanding['RIO'],
            'net_debt': 4679e6
        },
        {
            'stock': 'CALM',
            'current_price': current_prices['CALM'],
            'projected_cash_flows': [346e6, 360e6, 375e6, 390e6, 407e6, 424e6, 442e6],
            'terminal_growth_rate': 0.015,
            'discount_rate': 0.071,
            'shares_outstanding': shares_outstanding['CALM'],
            'net_debt': -812e6
        },
        {
            'stock': 'GOOGL',
            'current_price': current_prices['GOOGL'],
            'projected_cash_flows': [79018e6, 95950e6, 118123e6, 141540e6, 167437e6, 195616e6, 225769e6, 257473e6],
            'terminal_growth_rate': 0.03,
            'discount_rate': 0.105,
            'shares_outstanding': shares_outstanding['GOOGL'],
            'net_debt': -82049e6
        }
    ]
    # Calculate expected returns using DCF
    Q = calculate_expected_returns(dcf_inputs)
    # Define P matrix for views
    P = np.eye(N)
    # Define risk aversion and tau
    delta = 2.5
    tau = 0.05
    # Calculate posterior expected returns and covariance matrix
    mu_bl, Sigma_bl = black_litterman(Sigma, w_mkt, P, Q, tau, delta)
    # Set up optimization problem using cvxpy
    w = cp.Variable(N)
    risk_aversion = delta
    objective = cp.Minimize((1/2) * cp.quad_form(w, Sigma_bl) - risk_aversion * mu_bl @ w)
    constraints = [
        cp.sum(w) == 1,
        w >= 0
    ]
    problem = cp.Problem(objective, constraints)
    problem.solve()
    # Get optimal weights
    w_bl = w.value
    # Print optimal portfolio weights
    print("\nOptimal Portfolio Weights (Black-Litterman with Constraints):")
    for stock, weight in zip(stocks, w_bl):
        print(f"{stock}: {weight * 100:.2f}%")
    # Calculate portfolio returns
    portfolio_returns_bl = returns @ w_bl
    equal_weights = np.full(N, 1 / N)
    portfolio_returns_equal = returns @ equal_weights
    # Calculate cumulative returns
    cumulative_returns_bl = (1 + portfolio_returns_bl).cumprod()
    cumulative_returns_equal = (1 + portfolio_returns_equal).cumprod()
    # Plot cumulative returns
    plt.figure(figsize=(10, 6))
    plt.plot(cumulative_returns_bl.index, cumulative_returns_bl, label='Black-Litterman Portfolio')
    plt.plot(cumulative_returns_equal.index, cumulative_returns_equal, label='Equal-Weighted Portfolio')
    plt.title('Cumulative Returns')
    plt.xlabel('Date')
    plt.ylabel('Cumulative Return')
    plt.legend()
    plt.grid(True)
    plt.show()

if __name__ == "__main__":
    main()
