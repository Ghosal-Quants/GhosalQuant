@startuml
title Minimal Trading System

skinparam componentStyle rectangle
skinparam shadowing false
skinparam arrowThickness 1.5
skinparam nodesep 10
skinparam ranksep 10

package "Execution System" {
  [Data Parser]
  [Strategy]
  [SignalSink]
}

package "Data Layer" {
  [DataSource]
  [LocalDataSource]
  [StreamingDataSource]
  [YFinanceDataSource]
  [DataFrameDataSource]
}

package "Backtester" {
  [Data bank/cache]
  [Sample(s) (Sliding window/stream)]
  [Evaluation System]
}

package "Reporting System" {
  [Graphs / Tables / Charts]
  [CSV / Console Logging]
}

' Wiring
[DataSource] <|-- [LocalDataSource]
[DataSource] <|-- [YFinanceDataSource]
[DataSource] <|-- [DataFrameDataSource]
[DataSource] <|-- [StreamingDataSource]

[StreamingDataSource] --> [Data bank/cache]
[DataSource] --> [Data Parser] : data in
[Data Parser] --> [Strategy] : Bar
[Strategy] --> [SignalSink] : Signal

' Backtester
[Data bank/cache] --> [Sample(s) (Sliding window/stream)]
[Sample(s) (Sliding window/stream)] --> [DataFrameDataSource] : feeds
[SignalSink] --> [Evaluation System]

' Reporting
[Evaluation System] --> [Graphs / Tables / Charts]
[Evaluation System] --> [CSV / Console Logging]
@enduml
