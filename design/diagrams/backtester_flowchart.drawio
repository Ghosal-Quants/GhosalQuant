                </mxCell>
                <mxCell id="59" value="This file should handle the getting of data - ideally giving back a consistent set of data in a. predictable form such that we can parse into a DF" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-50" y="-450" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="60" value="The idea hear is that the strategy class and associated functions can be abstracted away and &quot;blackboxed&quot; from the rest of the system - The system should be stable enough that the strategy() class is that the only thing we edit when testing new strategies - as such it should always take in a fixed type." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
