                <mxCell id="275" value="&lt;div style=&quot;color: rgb(248, 248, 242); background-color: rgb(14, 20, 25); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 18px; white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #6272a4;&quot;&gt;# ------------------------------------------------&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #6272a4;&quot;&gt;# General System Settings&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #6272a4;&quot;&gt;# ------------------------------------------------&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8be9fd;&quot;&gt;SYSTEM&lt;/span&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: #6272a4;&quot;&gt;# The location of the historical data files&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: #8be9fd;&quot;&gt;target&lt;/span&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: #f1fa8c;&quot;&gt;&quot;AAPL&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: #6272a4;&quot;&gt;# The timeframe for the main data (e.g., H1, M30, D1)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: #8be9fd;&quot;&gt;main_timeframe&lt;/span&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: #f1fa8c;&quot;&gt;&quot;H1&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: #6272a4;&quot;&gt;# The timeframe for execution/signal checks (e.g., M5)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: #8be9fd;&quot;&gt;execution_timeframe&lt;/span&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: #f1fa8c;&quot;&gt;&quot;M5&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: #6272a4;&quot;&gt;# Use multiprocessing for faster testing&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: #6272a4;&quot;&gt;# use_multiprocessing: True&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: #6272a4;&quot;&gt;# Number of CPU cores to dedicate to the process&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: #6272a4;&quot;&gt;# num_processes: 4&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: #6272a4;&quot;&gt;# do we want fresh candles downloaded?&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: #8be9fd;&quot;&gt;fresh_candles = Tru&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 85, 85); font-style: italic; text-decoration-line: underline;&quot;&gt;e&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #6272a4;&quot;&gt;# ------------------------------------------------&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #6272a4;&quot;&gt;# Test Period and Range&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #6272a4;&quot;&gt;# ------------------------------------------------&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8be9fd;&quot;&gt;TIME_RANGE&lt;/span&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;  &lt;/span&gt;&lt;span style=&q