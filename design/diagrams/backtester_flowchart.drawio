                </mxCell>
                <mxCell id="50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="51" target="49" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="51" value="CRUX: How do we know when evaluating wins/losses whether or not the the price dipped above/below the TP/SL on a lower granularity&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;SOLUTION: We take a lower granularity as a dataframe, merge it into the larger timeframe and evaluate wins/losses based off of this lower time frame&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="310" y="570" width="360" height="80" as="geometry"/>
                </mxCell>
